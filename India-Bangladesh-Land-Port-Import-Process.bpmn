<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_IndiaBangladeshLandPort"
  targetNamespace="http://example.com/bpmn/india-bangladesh-land-port"
  exporter="Camunda Modeler"
  exporterVersion="5.0">

  <bpmn:process id="Process_IndiaBangladeshLandPort" name="India to Bangladesh Land-Port Import Process" isExecutable="false" camunda:historyTimeToLive="180">
    <bpmn:documentation>Current-state process map for a road consignment moving from Petrapole, India to the Bangladesh land port. Manual document movement, physical signatures, queues, and official inspection/testing steps are represented explicitly.</bpmn:documentation>

    <bpmn:laneSet id="LaneSet_Stakeholders">
      <bpmn:lane id="Lane_Exporter" name="Indian Exporter / Indian C&amp;F">
        <bpmn:flowNodeRef>StartEvent_ExportOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitIndianCustoms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessExportPermit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConsignmentReady</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IndianBorder" name="Indian Customs / Border Operations">
        <bpmn:flowNodeRef>Task_CargoArrivesPetrapole</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IndianBorderHandover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CustomsCopies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyStampCarPass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnStampedCarPass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TruckCrossesBorder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BangladeshEntry" name="Bangladesh Entry Team (BGB / BLPA / Customs / Bonderman)">
        <bpmn:flowNodeRef>Task_JointEntryReception</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateIGM</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BangladeshCF" name="Bangladesh C&amp;F / Posting Staff">
        <bpmn:flowNodeRef>Task_WeighbridgeEntry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GetReleaseNote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FindWarehouseSpot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GetWarehouseApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreatePosting</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WarehouseBLPA" name="Warehouse / BLPA Port Authority">
        <bpmn:flowNodeRef>Task_MoveToWarehouse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UnloadCargo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeReleaseToBLPA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BLPAApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PayPortFees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EndorseAndGatePass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyExitDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PaymentDateCurrent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PayAdditionalCharge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_TruckReleased</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BangladeshCustoms" name="Bangladesh Customs">
        <bpmn:flowNodeRef>Task_SubmitBillOfEntry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskChannel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaitForExamOfficer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PhysicalExamination</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TestRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OfficialTesting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TestMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssessDuties</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IssueDeliveryOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ImporterBank" name="Importer / Bank">
        <bpmn:flowNodeRef>Task_ProvideImportDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PayCustomsDuty</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_ExportOrder" name="Consignment planned">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_PrepareDocuments" name="Prepare invoice and packing list">
      <bpmn:incoming>Flow_01</bpmn:incoming><bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SubmitIndianCustoms" name="Submit documents for Indian export clearance">
      <bpmn:incoming>Flow_02</bpmn:incoming><bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ProcessExportPermit" name="Process export permit in Customs e-EXP">
      <bpmn:incoming>Flow_03</bpmn:incoming><bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_ConsignmentReady" name="Confirm consignment ready for export">
      <bpmn:incoming>Flow_04</bpmn:incoming><bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CargoArrivesPetrapole" name="Cargo arrives at Petrapole">
      <bpmn:incoming>Flow_05</bpmn:incoming><bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_IndianBorderHandover" name="Carry and hand over border documents at zero point">
      <bpmn:incoming>Flow_06</bpmn:incoming><bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CustomsCopies" name="Indian Customs retains 1 copy; driver receives 2 copies">
      <bpmn:incoming>Flow_07</bpmn:incoming><bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_VerifyStampCarPass" name="Verify documents and stamp CARPASS">
      <bpmn:incoming>Flow_08</bpmn:incoming><bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReturnStampedCarPass" name="Carry stamped CARPASS back to zero point">
      <bpmn:incoming>Flow_09</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_TruckCrossesBorder" name="Indian truck crosses into Bangladesh">
      <bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_JointEntryReception" name="Jointly receive truck at entry gate">
      <bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CreateIGM" name="Record CARPASS entry number as IGM">
      <bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_WeighbridgeEntry" name="Weigh truck at port weighbridge">
      <bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_GetReleaseNote" name="Inform shed officer; obtain and manually approve release note">
      <bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_FindWarehouseSpot" name="Find and wait for a free warehouse spot">
      <bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_GetWarehouseApproval" name="Obtain warehouse approval and signature">
      <bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CreatePosting" name="Posting officer assigns truck to warehouse">
      <bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_MoveToWarehouse" name="Move truck to warehouse and wait for receipt">
      <bpmn:incoming>Flow_18</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_UnloadCargo" name="Unload cargo">
      <bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_ProvideImportDocuments" name="Provide bank-endorsed import documents">
      <bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SubmitBillOfEntry" name="Submit Bill of Entry in ASYCUDA with hard copies">
      <bpmn:incoming>Flow_21</bpmn:incoming><bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_RiskChannel" name="Risk channel?" default="Flow_24">
      <bpmn:incoming>Flow_22</bpmn:incoming><bpmn:outgoing>Flow_23</bpmn:outgoing><bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_WaitForExamOfficer" name="Queue for assigned examination officer">
      <bpmn:incoming>Flow_23</bpmn:incoming><bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PhysicalExamination" name="Conduct 100% physical examination">
      <bpmn:incoming>Flow_25</bpmn:incoming><bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_RiskMerge">
      <bpmn:incoming>Flow_24</bpmn:incoming><bpmn:incoming>Flow_26</bpmn:incoming><bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_TestRequired" name="Official testing required?" default="Flow_29">
      <bpmn:incoming>Flow_27</bpmn:incoming><bpmn:outgoing>Flow_28</bpmn:outgoing><bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_OfficialTesting" name="Perform required BSTI, laboratory, or quarantine testing">
      <bpmn:incoming>Flow_28</bpmn:incoming><bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_TestMerge">
      <bpmn:incoming>Flow_29</bpmn:incoming><bpmn:incoming>Flow_30</bpmn:incoming><bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_AssessDuties" name="Assess duties under tariff and applicable SRO">
      <bpmn:incoming>Flow_31</bpmn:incoming><bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PayCustomsDuty" name="Pay Customs duty online or by bank transfer">
      <bpmn:incoming>Flow_32</bpmn:incoming><bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_IssueDeliveryOrder" name="Issue Customs delivery / release order">
      <bpmn:incoming>Flow_33</bpmn:incoming><bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_TakeReleaseToBLPA" name="Carry physical release order to BLPA main office">
      <bpmn:incoming>Flow_34</bpmn:incoming><bpmn:outgoing>Flow_35</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BLPAApproval" name="Obtain BLPA billing approvals">
      <bpmn:incoming>Flow_35</bpmn:incoming><bpmn:outgoing>Flow_36</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PayPortFees" name="Pay port fees at bank">
      <bpmn:incoming>Flow_36</bpmn:incoming><bpmn:outgoing>Flow_37</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_EndorseAndGatePass" name="Obtain billing endorsement and gate / exit pass">
      <bpmn:incoming>Flow_37</bpmn:incoming><bpmn:outgoing>Flow_38</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_VerifyExitDocuments" name="Verify exit documents and BLPA payment date">
      <bpmn:incoming>Flow_38</bpmn:incoming><bpmn:incoming>Flow_41</bpmn:incoming><bpmn:outgoing>Flow_39</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_PaymentDateCurrent" name="Payment date is today?" default="Flow_40">
      <bpmn:incoming>Flow_39</bpmn:incoming><bpmn:outgoing>Flow_40</bpmn:outgoing><bpmn:outgoing>Flow_42</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PayAdditionalCharge" name="Pay applicable additional charge">
      <bpmn:incoming>Flow_40</bpmn:incoming><bpmn:outgoing>Flow_41</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_TruckReleased" name="Truck exits port">
      <bpmn:incoming>Flow_42</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_ExportOrder" targetRef="Task_PrepareDocuments"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_PrepareDocuments" targetRef="Task_SubmitIndianCustoms"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_SubmitIndianCustoms" targetRef="Task_ProcessExportPermit"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_ProcessExportPermit" targetRef="Task_ConsignmentReady"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_ConsignmentReady" targetRef="Task_CargoArrivesPetrapole"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_CargoArrivesPetrapole" targetRef="Task_IndianBorderHandover"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_IndianBorderHandover" targetRef="Task_CustomsCopies"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_CustomsCopies" targetRef="Task_VerifyStampCarPass"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_VerifyStampCarPass" targetRef="Task_ReturnStampedCarPass"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ReturnStampedCarPass" targetRef="Task_TruckCrossesBorder"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_TruckCrossesBorder" targetRef="Task_JointEntryReception"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_JointEntryReception" targetRef="Task_CreateIGM"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_CreateIGM" targetRef="Task_WeighbridgeEntry"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_WeighbridgeEntry" targetRef="Task_GetReleaseNote"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_GetReleaseNote" targetRef="Task_FindWarehouseSpot"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_FindWarehouseSpot" targetRef="Task_GetWarehouseApproval"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_GetWarehouseApproval" targetRef="Task_CreatePosting"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_CreatePosting" targetRef="Task_MoveToWarehouse"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_MoveToWarehouse" targetRef="Task_UnloadCargo"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_UnloadCargo" targetRef="Task_ProvideImportDocuments"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_ProvideImportDocuments" targetRef="Task_SubmitBillOfEntry"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_SubmitBillOfEntry" targetRef="Gateway_RiskChannel"/>
    <bpmn:sequenceFlow id="Flow_23" name="Red" sourceRef="Gateway_RiskChannel" targetRef="Task_WaitForExamOfficer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${riskChannel == 'RED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_24" name="Yellow / Green" sourceRef="Gateway_RiskChannel" targetRef="Gateway_RiskMerge"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_WaitForExamOfficer" targetRef="Task_PhysicalExamination"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_PhysicalExamination" targetRef="Gateway_RiskMerge"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Gateway_RiskMerge" targetRef="Gateway_TestRequired"/>
    <bpmn:sequenceFlow id="Flow_28" name="Yes" sourceRef="Gateway_TestRequired" targetRef="Task_OfficialTesting">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${testingRequired == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_29" name="No" sourceRef="Gateway_TestRequired" targetRef="Gateway_TestMerge"/>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_OfficialTesting" targetRef="Gateway_TestMerge"/>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Gateway_TestMerge" targetRef="Task_AssessDuties"/>
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_AssessDuties" targetRef="Task_PayCustomsDuty"/>
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Task_PayCustomsDuty" targetRef="Task_IssueDeliveryOrder"/>
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_IssueDeliveryOrder" targetRef="Task_TakeReleaseToBLPA"/>
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_TakeReleaseToBLPA" targetRef="Task_BLPAApproval"/>
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Task_BLPAApproval" targetRef="Task_PayPortFees"/>
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Task_PayPortFees" targetRef="Task_EndorseAndGatePass"/>
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Task_EndorseAndGatePass" targetRef="Task_VerifyExitDocuments"/>
    <bpmn:sequenceFlow id="Flow_39" sourceRef="Task_VerifyExitDocuments" targetRef="Gateway_PaymentDateCurrent"/>
    <bpmn:sequenceFlow id="Flow_40" name="No" sourceRef="Gateway_PaymentDateCurrent" targetRef="Task_PayAdditionalCharge"/>
    <bpmn:sequenceFlow id="Flow_41" sourceRef="Task_PayAdditionalCharge" targetRef="Task_VerifyExitDocuments"/>
    <bpmn:sequenceFlow id="Flow_42" name="Yes" sourceRef="Gateway_PaymentDateCurrent" targetRef="EndEvent_TruckReleased">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${blpaPaymentDateCurrent == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:textAnnotation id="TextAnnotation_ExportDocs"><bpmn:text>Export handover set: invoice, packing list, BL/shipping bill, export permit, CARPASS, manifest, and driver details.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_ExportDocs" sourceRef="Task_IndianBorderHandover" targetRef="TextAnnotation_ExportDocs"/>
    <bpmn:textAnnotation id="TextAnnotation_ImportDocs"><bpmn:text>Import set: bank-endorsed documents, LC copies, authorization letters, and SRO exemption support where applicable (including undertakings, guarantees, and authority clearances).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_ImportDocs" sourceRef="Task_ProvideImportDocuments" targetRef="TextAnnotation_ImportDocs"/>
    <bpmn:textAnnotation id="TextAnnotation_Manual"><bpmn:text>Most Bangladesh-side handling is manual and requires original hard copies and physical signatures; only initial Bill of Entry submission is electronic in ASYCUDA.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_Manual" sourceRef="Task_SubmitBillOfEntry" targetRef="TextAnnotation_Manual"/>
    <bpmn:textAnnotation id="TextAnnotation_Queues"><bpmn:text>Known delay points include examination-officer availability, testing queues, warehouse-slot availability, weighbridges, and movement of physical documents.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_Queues" sourceRef="Task_WaitForExamOfficer" targetRef="TextAnnotation_Queues"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Main">
    <bpmndi:BPMNPlane id="BPMNPlane_Main" bpmnElement="Process_IndiaBangladeshLandPort">
      <bpmndi:BPMNShape id="Lane_Exporter_di" bpmnElement="Lane_Exporter" isHorizontal="true"><dc:Bounds x="80" y="80" width="6320" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_IndianBorder_di" bpmnElement="Lane_IndianBorder" isHorizontal="true"><dc:Bounds x="80" y="220" width="6320" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BangladeshEntry_di" bpmnElement="Lane_BangladeshEntry" isHorizontal="true"><dc:Bounds x="80" y="360" width="6320" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BangladeshCF_di" bpmnElement="Lane_BangladeshCF" isHorizontal="true"><dc:Bounds x="80" y="500" width="6320" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_WarehouseBLPA_di" bpmnElement="Lane_WarehouseBLPA" isHorizontal="true"><dc:Bounds x="80" y="640" width="6320" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BangladeshCustoms_di" bpmnElement="Lane_BangladeshCustoms" isHorizontal="true"><dc:Bounds x="80" y="780" width="6320" height="160"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ImporterBank_di" bpmnElement="Lane_ImporterBank" isHorizontal="true"><dc:Bounds x="80" y="940" width="6320" height="140"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_ExportOrder_di" bpmnElement="StartEvent_ExportOrder"><dc:Bounds x="150" y="132" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="128" y="174" width="82" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PrepareDocuments_di" bpmnElement="Task_PrepareDocuments"><dc:Bounds x="230" y="110" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SubmitIndianCustoms_di" bpmnElement="Task_SubmitIndianCustoms"><dc:Bounds x="410" y="110" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ProcessExportPermit_di" bpmnElement="Task_ProcessExportPermit"><dc:Bounds x="600" y="110" width="140" height="80"/></bpmndi:BPMNShape>
