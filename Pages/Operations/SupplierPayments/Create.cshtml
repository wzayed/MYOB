@page
@model MYOB.Pages.Operations.SupplierPayments.CreateModel
@using System.Globalization

@{
    ViewData["Title"] = "إضافة حركة دفع";
}

<h1>إضافة دفع إلى مورد</h1>

<form method="get" class="card card-body mb-3">
    <label class="form-label">المورد</label>
    <select asp-for="SupplierId" asp-items="Model.Suppliers" class="form-select" onchange="this.form.submit()">
        <option value="">اختر المورد</option>
    </select>
</form>

@if (Model.SupplierId.HasValue)
{
    <form method="post" class="card card-body">
        <input asp-for="Item.SupplierId" type="hidden" />
        <input asp-for="Item.SupplierCreditId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        @if (Model.AvailableCredit is not null)
        {
            <div class="alert alert-info">
                رصيد مرحل متاح: <strong>@Model.AvailableCredit.RemainingAmount.ToString("N2")</strong>
                — @Model.AvailableCredit.CarryForwardNote
            </div>
        }

        <div class="row g-3 mb-3">
            <div class="col-md-3">
                <label class="form-label">التاريخ</label>
                <input asp-for="Item.Date" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control" />
                <span asp-validation-for="Item.Date" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label">طريقة السداد</label>
                @if (Model.AvailableCredit is not null)
                {
                    <input asp-for="Item.PaymentMethodId" type="hidden" />
                    <input class="form-control" value="@Model.AvailableCredit.PaymentMethodName" readonly />
                }
                else
                {
                    <select asp-for="Item.PaymentMethodId" asp-items="Model.Methods" class="form-select"><option value="">اختر طريقة السداد</option></select>
                }
            </div>
            <div class="col-md-3">
                <label class="form-label">إجمالي المبلغ المدفوع</label>
                <input id="paymentTotal" asp-for="Item.TotalAmount" class="form-control" min="0.01" step="0.01" />
                <span asp-validation-for="Item.TotalAmount" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label">الرصيد الدائن الجديد</label>
                <input id="distributionRemaining" class="form-control" value="0.00" readonly />
            </div>
            @if (Model.AvailableCredit is not null)
            {
                <div class="col-md-3"><label class="form-label">الرصيد المرحل المستخدم</label><input id="creditUsed" class="form-control" readonly /></div>
                <div class="col-md-3"><label class="form-label">المبلغ المدفوع الآن</label><input id="cashPaidNow" class="form-control" readonly /></div>
            }
            <div class="col-12">
                <label for="Item_Comments" class="form-label">ملاحظات خاصة</label>
                <button type="button" class="btn btn-sm btn-outline-secondary ms-2" data-copy-payment-notes
                        title="نسخ الملاحظات الخاصة إلى العامة" aria-label="نسخ الملاحظات الخاصة إلى العامة">↓</button>
                <input asp-for="Item.Comments" class="form-control" readonly="@(Model.AvailableCredit is not null ? "readonly" : null)" />
                <span asp-validation-for="Item.Comments" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Item.PublicComments" class="form-label">ملاحظات عامة</label>
                <input asp-for="Item.PublicComments" class="form-control" />
                <span asp-validation-for="Item.PublicComments" class="text-danger"></span>
            </div>
        </div>

        <h5>توزيع المبلغ على البوالص</h5>
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead>
                    <tr>
                        <th>تاريخ البوليصة</th>
                        <th>رقم البوليصة / أمر الشحن</th>
                        <th>الخامة</th>
                        <th>المبلغ غير المدفوع</th>
                        <th>المبلغ المدفوع الآن</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Policies.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center py-4">لا توجد بوالص غير مدفوعة لهذا المورد</td></tr>
                    }
                    @for (var i = 0; i < Model.Item.Allocations.Count; i++)
                    {
                        var allocation = Model.Item.Allocations[i];
                        var policy = Model.Policies.First(x => x.Id == allocation.SupplierReceiptId);
                        <tr>
                            <td>@policy.PolicyDate.ToString("yyyy/MM/dd")</td>
                            <td>
                                @policy.PolicyNumber
                                <input asp-for="Item.Allocations[i].SupplierReceiptId" type="hidden" />
                            </td>
                            <td>@policy.MaterialName</td>
                            <td>@policy.RemainingAmount.ToString("N2")</td>
                            <td>
                                <input asp-for="Item.Allocations[i].Amount"
                                       class="form-control payment-allocation"
                                       min="0"
                                       max="@policy.RemainingAmount.ToString(CultureInfo.InvariantCulture)"
                                       step="0.01" />
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="4">إجمالي المبلغ الموزع</td>
                        <td id="allocationTotal">0.00</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="mt-3">
            <button id="savePayment" class="btn btn-primary" disabled>حفظ</button>
            <a asp-page="Index" class="btn btn-secondary">إلغاء</a>
        </div>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const inputs = [...document.querySelectorAll('.payment-allocation')];
            const paymentTotal = document.getElementById('paymentTotal');
            const allocatedTotal = document.getElementById('allocationTotal');
            const remaining = document.getElementById('distributionRemaining');
            const save = document.getElementById('savePayment');
            const creditUsedField = document.getElementById('creditUsed');
            const cashPaidNow = document.getElementById('cashPaidNow');
            const availableCredit = @Html.Raw(Model.AvailableCredit?.RemainingAmount.ToString(CultureInfo.InvariantCulture) ?? "0");

            const update = () => {
                const paid = parseFloat(paymentTotal?.value) || 0;
                const allocated = inputs.reduce((sum, input) => sum + (parseFloat(input.value) || 0), 0);
                const left = paid - allocated;
                const normalizedLeft = Math.abs(left) < 0.005 ? 0 : left;
                const creditUsed = Math.min(availableCredit, allocated);

                if (allocatedTotal) allocatedTotal.textContent = allocated.toFixed(2);
                if (remaining) {
                    remaining.value = normalizedLeft.toFixed(2);
                    remaining.classList.toggle('is-invalid', normalizedLeft < 0);
                }
                if (creditUsedField) creditUsedField.value = creditUsed.toFixed(2);
                if (cashPaidNow) cashPaidNow.value = Math.max(0, paid - creditUsed).toFixed(2);
                if (save) save.disabled = paid <= 0 || allocated <= 0 || normalizedLeft < 0 || inputs.length === 0;
            };

            paymentTotal?.addEventListener('input', update);
            inputs.forEach(input => input.addEventListener('input', update));
            update();
        })();
    </script>
}
