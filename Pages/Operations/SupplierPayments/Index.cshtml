@page
@model MYOB.Pages.Operations.SupplierPayments.IndexModel
@{ViewData["Title"]="دفع إلى مورد";}<div class="d-flex justify-content-between mb-3"><h1>دفع إلى مورد</h1>@if(Model.CanAdd){<a asp-page="Create" class="btn btn-primary">إضافة حركة دفع</a>}</div>@if(TempData["Message"] is string m){<div class="alert alert-success">@m</div>}<form method="get" class="row g-2 mb-3"><div class="col-md-5"><input asp-for="Search" class="form-control" placeholder="المورد أو البوليصة أو طريقة الدفع"/></div><div class="col-auto"><button class="btn btn-outline-primary">بحث</button> <a asp-page="Index" class="btn btn-outline-secondary">مسح المرشحات</a></div></form><table class="table table-striped"><thead><tr><th>التاريخ</th><th>المورد</th><th>البوليصة</th><th>المبلغ</th><th>طريقة الدفع</th><th>ملاحظات</th><th>إجراءات</th></tr></thead><tbody>@if(Model.Items.Count==0){<tr><td colspan="7" class="text-center py-4">لا توجد بيانات</td></tr>}@foreach(var x in Model.Items){<tr><td>@x.Date</td><td>@x.Supplier.Name</td><td>@x.SupplierReceipt.PolicyNumber</td><td>@x.Amount.ToString("N2")</td><td>@x.PaymentMethod.Name</td><td>@x.Comments</td><td>@if(Model.CanUpdate){<a asp-page="Edit" asp-route-id="@x.Id" class="btn btn-sm btn-outline-primary">تعديل</a>} @if(Model.CanDelete){<form method="post" asp-page-handler="Delete" asp-route-id="@x.Id" class="d-inline"><button class="btn btn-sm btn-outline-danger">حذف</button></form>}</td></tr>}</tbody></table><nav><ul class="pagination">@for(var p=1;p<=Model.TotalPages;p++){<li class="page-item @(p==Model.PageNumber?"active":"")"><a class="page-link" asp-route-PageNumber="@p" asp-route-Search="@Model.Search">@p</a></li>}</ul></nav>
