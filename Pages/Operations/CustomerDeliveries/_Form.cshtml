@model MYOB.DTOs.CustomerDeliveryForm
@{var policies=ViewData["Policies"] as IReadOnlyList<MYOB.DTOs.PolicyOption>??[];}
<form method="post" class="card card-body"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-5"><label class="form-label">العميل</label><select asp-for="CustomerId" asp-items="@(ViewData["Customers"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-select"><option value="">اختر العميل</option></select></div><div class="col-md-3"><label class="form-label">التاريخ</label><input asp-for="Date" type="date" class="form-control"/></div><div class="col-md-4"><label class="form-label">رقم البوليصة / أمر الشحن غير المخصص</label><select id="policy" asp-for="SupplierReceiptId" class="form-select"><option value="">اختر البوليصة</option>@foreach(var p in policies){<option value="@p.Id" data-material="@p.MaterialName" data-qty="@p.Quantity" data-unit="@p.UnitName">@p.PolicyNumber</option>}</select></div><div class="col-md-4"><label class="form-label">الخامة</label><input id="material" class="form-control" readonly/></div><div class="col-md-4"><label class="form-label">الوزن / الكمية</label><input id="qty" class="form-control" readonly/></div><div class="col-md-4"><label class="form-label">الوحدة</label><input id="unit" class="form-control" readonly/></div><div class="col-md-3"><label class="form-label">سعر الوحدة</label><input id="price" asp-for="UnitPrice" class="form-control"/></div><div class="col-md-3"><label class="form-label">الضريبة</label><div class="input-group"><input id="tax" asp-for="TaxPercent" class="form-control"/><span class="input-group-text">%</span></div></div><div class="col-md-3"><label class="form-label">الإجمالي</label><input id="total" class="form-control" readonly/></div><div class="col-md-3"><label class="form-label">تفاصيل</label><input asp-for="Details" class="form-control"/></div></div><div class="mt-3"><button class="btn btn-primary">حفظ</button> <a asp-page="Index" class="btn btn-secondary">إلغاء</a></div></form>
