<script>(()=>{const policy=document.getElementById('policy'),material=document.getElementById('material'),qty=document.getElementById('qty'),unit=document.getElementById('unit'),purchasePrice=document.getElementById('purchasePrice'),purchaseTax=document.getElementById('purchaseTax'),purchaseTotal=document.getElementById('purchaseTotal'),price=document.getElementById('price'),tax=document.getElementById('tax'),total=document.getElementById('total');if(!policy)return;const update=()=>{const o=policy.selectedOptions[0];if(material)material.value=o?.dataset.material||'';if(qty)qty.value=o?.dataset.qty||'';if(unit)unit.value=o?.dataset.unit||'';if(purchasePrice)purchasePrice.value=o?.dataset.purchasePrice||'';if(purchaseTax)purchaseTax.value=o?.dataset.purchaseTax||'';if(purchaseTotal)purchaseTotal.value=o?.dataset.purchaseTotal||'';if(total)total.value=((parseFloat(qty?.value)||0)*(parseFloat(price?.value)||0)*(1+(parseFloat(tax?.value)||0)/100)).toFixed(2)};[policy,price,tax].filter(Boolean).forEach(x=>x.addEventListener('input',update));update()})();</script>
