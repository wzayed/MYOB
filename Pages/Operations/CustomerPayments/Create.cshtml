@page
@model MYOB.Pages.Operations.CustomerPayments.CreateModel
@using System.Globalization

@{
    ViewData["Title"] = "إضافة حركة قبض";
}

<h1>إضافة قبض من عميل</h1>

<form method="get" class="card card-body mb-3">
    <label class="form-label">العميل</label>
    <select asp-for="CustomerId" asp-items="Model.Customers" class="form-select" onchange="this.form.submit()">
        <option value="">اختر العميل</option>
    </select>
</form>

@if (Model.CustomerId.HasValue)
{
    <form method="post" class="card card-body">
        <input asp-for="Item.CustomerId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row g-3 mb-3">
            <div class="col-md-3">
                <label class="form-label">التاريخ</label>
                <input asp-for="Item.Date" type="date" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">طريقة السداد</label>
                <select asp-for="Item.PaymentMethodId" asp-items="Model.Methods" class="form-select">
                    <option value="">اختر طريقة السداد</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">إجمالي المبلغ المستلم</label>
                <input id="receiptTotal" asp-for="Item.TotalAmount" class="form-control" min="0.01" step="0.01" />
                <span asp-validation-for="Item.TotalAmount" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label">المتبقي للتوزيع</label>
                <input id="distributionRemaining" class="form-control" value="0.00" readonly />
            </div>
            <div class="col-12">
                <label class="form-label">ملاحظات</label>
                <input asp-for="Item.Comments" class="form-control" />
            </div>
        </div>

        <h5>توزيع المبلغ على البوالص</h5>
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead>
                    <tr>
                        <th>تاريخ البوليصة</th>
                        <th>رقم البوليصة / أمر الشحن</th>
                        <th>الخامة</th>
                        <th>المبلغ غير المحصل</th>
                        <th>المبلغ المحصل الآن</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Policies.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center py-4">لا توجد بوالص غير محصلة لهذا العميل</td></tr>
                    }
                    @for (var i = 0; i < Model.Item.Allocations.Count; i++)
                    {
                        var allocation = Model.Item.Allocations[i];
                        var policy = Model.Policies.First(x => x.Id == allocation.CustomerDeliveryId);
                        <tr>
                            <td>@policy.PolicyDate.ToString("yyyy/MM/dd")</td>
                            <td>
                                @policy.PolicyNumber
                                <input asp-for="Item.Allocations[i].CustomerDeliveryId" type="hidden" />
                            </td>
                            <td>@policy.MaterialName</td>
                            <td>@policy.RemainingAmount.ToString("N2")</td>
                            <td>
                                <input asp-for="Item.Allocations[i].Amount"
                                       class="form-control payment-allocation"
                                       min="0"
                                       max="@policy.RemainingAmount.ToString(CultureInfo.InvariantCulture)"
                                       step="0.01" />
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="4">إجمالي المبلغ الموزع</td>
                        <td id="allocationTotal">0.00</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="mt-3">
            <button id="savePayment" class="btn btn-primary" disabled>حفظ</button>
            <a asp-page="Index" class="btn btn-secondary">إلغاء</a>
        </div>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const inputs = [...document.querySelectorAll('.payment-allocation')];
            const receiptTotal = document.getElementById('receiptTotal');
            const allocatedTotal = document.getElementById('allocationTotal');
            const remaining = document.getElementById('distributionRemaining');
            const save = document.getElementById('savePayment');

            const update = () => {
                const received = parseFloat(receiptTotal?.value) || 0;
                const allocated = inputs.reduce((sum, input) => sum + (parseFloat(input.value) || 0), 0);
                const left = received - allocated;

                if (allocatedTotal) allocatedTotal.textContent = allocated.toFixed(2);
                if (remaining) {
                    remaining.value = left.toFixed(2);
                    remaining.classList.toggle('is-invalid', left < 0);
                }
                if (save) save.disabled = received <= 0 || Math.abs(left) > .009 || inputs.length === 0;
            };

            receiptTotal?.addEventListener('input', update);
            inputs.forEach(input => input.addEventListener('input', update));
            update();
        })();
    </script>
}
