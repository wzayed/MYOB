@model MYOB.DTOs.CustomerPaymentForm
@{var policies=ViewData["Policies"] as IReadOnlyList<MYOB.DTOs.PolicyOption>??[];}
<form method="post" class="card card-body"><input asp-for="Id" type="hidden"/><input asp-for="CustomerId" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label class="form-label">رقم البوليصة / أمر الشحن</label><select id="policy" asp-for="CustomerDeliveryId" class="form-select"><option value="">اختر البوليصة</option>@foreach(var p in policies){<option value="@p.Id" data-remaining="@p.RemainingAmount">@p.PolicyNumber</option>}</select></div><div class="col-md-3"><label class="form-label">المبلغ غير المحصل</label><input id="remaining" class="form-control" readonly/></div><div class="col-md-3"><label class="form-label">التاريخ</label><input asp-for="Date" type="date" class="form-control"/></div><div class="col-md-4"><label class="form-label">المبلغ المحصل</label><input asp-for="Amount" class="form-control"/></div><div class="col-md-4"><label class="form-label">طريقة السداد</label><select asp-for="PaymentMethodId" asp-items="@(ViewData["Methods"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-select"><option value="">اختر طريقة السداد</option></select></div><div class="col-md-4"><label class="form-label">ملاحظات</label><input asp-for="Comments" class="form-control"/></div></div><div class="mt-3"><button class="btn btn-primary">حفظ</button> <a asp-page="Index" class="btn btn-secondary">إلغاء</a></div></form>
