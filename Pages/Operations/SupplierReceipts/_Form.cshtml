@model MYOB.DTOs.SupplierReceiptForm
<form method="post" class="card card-body"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-4"><label class="form-label">المورد</label><select asp-for="SupplierId" asp-items="@(ViewData["Suppliers"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-select"><option value="">اختر المورد</option></select></div><div class="col-md-4"><label class="form-label">بحث عن الخامة</label><input id="materialSearch" class="form-control" placeholder="اكتب للبحث"/></div><div class="col-md-4"><label class="form-label">الخامة</label><select id="materialSelect" asp-for="MaterialId" asp-items="@(ViewData["Materials"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-select"><option value="">اختر الخامة</option></select></div><div class="col-md-3"><label class="form-label">التاريخ</label><input asp-for="Date" type="date" class="form-control"/></div><div class="col-md-5"><label class="form-label">رقم البوليصة / أمر الشحن</label><input asp-for="PolicyNumber" class="form-control"/></div><div class="col-md-2"><label class="form-label">الوزن / الكمية</label><input id="qty" asp-for="Quantity" class="form-control"/></div><div class="col-md-2"><label class="form-label">سعر الوحدة</label><input id="price" asp-for="UnitPrice" class="form-control"/></div><div class="col-md-3"><label class="form-label">الضريبة</label><div class="input-group"><input id="tax" asp-for="TaxPercent" class="form-control"/><span class="input-group-text">%</span></div></div><div class="col-md-3"><label class="form-label">الإجمالي</label><input id="total" class="form-control" readonly/></div><div class="col-md-6"><label class="form-label">تفاصيل</label><input asp-for="Details" class="form-control"/></div></div><div class="mt-3"><button class="btn btn-primary">حفظ</button> <a asp-page="Index" class="btn btn-secondary">إلغاء</a></div></form>
