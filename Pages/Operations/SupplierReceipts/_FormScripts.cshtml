<script>const calc=()=>{const q=parseFloat(qty.value)||0,p=parseFloat(price.value)||0,t=parseFloat(tax.value)||0;total.value=(q*p*(1+t/100)).toFixed(2)};[qty,price,tax].forEach(x=>x.addEventListener('input',calc));calc();const original=[...materialSelect.options];materialSearch.addEventListener('input',()=>{const selected=materialSelect.value,v=materialSearch.value.trim().toLowerCase();materialSelect.replaceChildren(...original.filter((o,i)=>i===0||o.text.toLowerCase().includes(v)).map(o=>o.cloneNode(true)));materialSelect.value=selected})</script>
