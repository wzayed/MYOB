<script>
(()=>{const qty=document.getElementById('qty'),price=document.getElementById('price'),tax=document.getElementById('tax'),total=document.getElementById('total');const calc=()=>{if(!total)return;const q=parseFloat(qty?.value)||0,p=parseFloat(price?.value)||0,t=parseFloat(tax?.value)||0;total.value=(q*p*(1+t/100)).toFixed(2)};[qty,price,tax].filter(Boolean).forEach(x=>x.addEventListener('input',calc));calc();document.querySelectorAll('[data-searchable-combobox]').forEach(box=>{const input=box.querySelector('.searchable-combobox-input'),value=box.querySelector('[data-combobox-value]'),menu=box.querySelector('.searchable-combobox-menu'),options=[...box.querySelectorAll('.searchable-combobox-option')],empty=box.querySelector('.searchable-combobox-empty');const open=()=>{menu.hidden=false;input.setAttribute('aria-expanded','true')};const close=()=>{menu.hidden=true;input.setAttribute('aria-expanded','false')};input.addEventListener('focus',open);input.addEventListener('click',open);input.addEventListener('input',()=>{value.value='';const term=input.value.trim().toLocaleLowerCase('ar');let visible=0;options.forEach(o=>{o.hidden=!o.textContent.toLocaleLowerCase('ar').includes(term);if(!o.hidden)visible++});empty.hidden=visible!==0;open()});options.forEach(o=>o.addEventListener('click',()=>{input.value=o.textContent.trim();value.value=o.dataset.value;close()}));document.addEventListener('click',e=>{if(!box.contains(e.target))close()})})})();
</script>
