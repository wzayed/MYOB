@page
@model MYOB.Pages.Settings.PaymentMethods.IndexModel
@{ViewData["Title"]="إعداد طرق الدفع";}<div class="d-flex justify-content-between mb-3"><h1>إعداد طرق الدفع</h1>@if(Model.CanAdd){<a asp-page="Create" class="btn btn-primary">إضافة طريقة دفع</a>}</div>@if(TempData["Message"] is string m){<div class="alert alert-success">@m</div>}@if(TempData["Error"] is string e){<div class="alert alert-danger">@e</div>}<form method="get" class="row g-2 mb-3"><div class="col-md-5"><input asp-for="Search" class="form-control" placeholder="بحث في طريقة الدفع أو الملاحظات"/></div><div class="col-auto"><button class="btn btn-outline-primary">بحث</button> <a asp-page="Index" class="btn btn-outline-secondary">مسح المرشحات</a></div></form><table class="table table-striped"><thead><tr><th>طريقة الدفع</th><th>ملاحظات</th><th>إجراءات</th></tr></thead><tbody>@if(Model.Items.Count==0){<tr><td colspan="3" class="text-center py-4">لا توجد بيانات</td></tr>}@foreach(var x in Model.Items){<tr><td>@x.Name</td><td>@x.Notes</td><td>@if(Model.CanUpdate){<a asp-page="Edit" asp-route-id="@x.Id" class="btn btn-sm btn-outline-primary">تعديل</a>} @if(Model.CanDelete){<form method="post" asp-page-handler="Delete" asp-route-id="@x.Id" class="d-inline"><button class="btn btn-sm btn-outline-danger">حذف</button></form>}</td></tr>}</tbody></table><nav><ul class="pagination">@for(var p=1;p<=Model.TotalPages;p++){<li class="page-item @(p==Model.PageNumber?"active":"")"><a class="page-link" asp-route-PageNumber="@p" asp-route-Search="@Model.Search">@p</a></li>}</ul></nav>
