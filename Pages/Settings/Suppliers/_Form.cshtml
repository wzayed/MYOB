@model MYOB.Models.Supplier
<form method="post" class="card card-body"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control"/></div><div class="col-md-8"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control"/></div><div class="col-md-4"><label asp-for="OpeningBalance" class="form-label"></label><input asp-for="OpeningBalance" class="form-control" inputmode="decimal"/></div><div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control"></textarea></div></div><div class="mt-3"><button class="btn btn-primary">حفظ</button> <a asp-page="Index" class="btn btn-secondary">إلغاء</a></div></form>
