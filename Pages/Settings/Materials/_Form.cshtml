@model MYOB.Models.Material
<form method="post" class="card card-body"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-md-6"><label asp-for="UnitOfMeasureId" class="form-label"></label><select asp-for="UnitOfMeasureId" asp-items="@(ViewData["Units"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-select"><option value="">اختر الوحدة</option></select><span asp-validation-for="UnitOfMeasureId" class="text-danger"></span></div><div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control"></textarea></div></div><div class="mt-3"><button class="btn btn-primary">حفظ</button> <a asp-page="Index" class="btn btn-secondary">إلغاء</a></div></form>
