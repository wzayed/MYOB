@page
@model MYOB.Pages.Settings.Users.IndexModel
@{ViewData["Title"]="المستخدمون والصلاحيات";}<div class="d-flex justify-content-between align-items-center mb-3"><h1>المستخدمون والصلاحيات</h1>@if(Model.CanAdd){<a asp-page="Create" class="btn btn-primary">إضافة مستخدم</a>}</div>@if(TempData["Message"] is string m){<div class="alert alert-success">@m</div>}<form method="get" class="row g-2 mb-3"><div class="col-md-5"><input asp-for="Search" class="form-control" placeholder="بحث بالاسم أو البريد"/></div><div class="col-auto"><button class="btn btn-outline-primary">بحث</button> <a asp-page="Index" class="btn btn-outline-secondary">مسح المرشحات</a></div></form><table class="table table-striped"><thead><tr><th>الاسم</th><th>البريد الإلكتروني</th><th>مدير نظام</th><th>إجراءات</th></tr></thead><tbody>@if(Model.Items.Count==0){<tr><td colspan="4" class="text-center py-4">لا توجد بيانات</td></tr>}@foreach(var x in Model.Items){<tr><td>@x.FullName</td><td>@x.Email</td><td>@(x.IsAdmin?"نعم":"لا")</td><td>@if(Model.CanUpdate){<a asp-page="Edit" asp-route-id="@x.Id" class="btn btn-sm btn-outline-primary">تعديل الصلاحيات</a>}</td></tr>}</tbody></table><nav><ul class="pagination">@for(var p=1;p<=Model.TotalPages;p++){<li class="page-item @(p==Model.PageNumber?"active":"")"><a class="page-link" asp-route-PageNumber="@p" asp-route-Search="@Model.Search">@p</a></li>}</ul></nav>
