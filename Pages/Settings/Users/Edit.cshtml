@page "{id}"
@model MYOB.Pages.Settings.Users.EditModel
@{ViewData["Title"]="تعديل المستخدم والصلاحيات";}<h1>تعديل المستخدم والصلاحيات</h1><form method="post"><input asp-for="Input.Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="card card-body mb-3"><div class="row g-3"><div class="col-md-6"><label class="form-label">الاسم</label><input asp-for="Input.FullName" class="form-control"/></div><div class="col-md-6"><label class="form-label">البريد الإلكتروني</label><input asp-for="Input.Email" class="form-control"/></div><div class="col-12 form-check"><input asp-for="Input.IsAdmin" class="form-check-input"/><label asp-for="Input.IsAdmin" class="form-check-label">مدير نظام بصلاحيات كاملة</label></div></div></div><div class="card"><div class="card-header">صلاحيات الشاشات</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>الشاشة</th><th>عرض</th><th>إضافة</th><th>تعديل</th><th>حذف</th></tr></thead><tbody>@for(var i=0;i<Model.Input.Permissions.Count;i++){var screen=Model.Screens.First(x=>x.Key==Model.Input.Permissions[i].ScreenKey);<tr><td>@screen.Group - @screen.Name<input asp-for="Input.Permissions[i].ScreenKey" type="hidden"/></td><td><input asp-for="Input.Permissions[i].CanView"/></td><td><input asp-for="Input.Permissions[i].CanAdd"/></td><td><input asp-for="Input.Permissions[i].CanUpdate"/></td><td><input asp-for="Input.Permissions[i].CanDelete"/></td></tr>}</tbody></table></div></div><div class="mt-3"><button class="btn btn-primary">حفظ</button> <a asp-page="Index" class="btn btn-secondary">إلغاء</a></div></form>
