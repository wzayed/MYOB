@using MYOB.Services
@using MYOB.Support
@using MYOB.Models
@using Microsoft.AspNetCore.Identity
@inject IPermissionService Permissions
@inject UserManager<ApplicationUser> UserManager
@{
    var access=new Dictionary<string,bool>();
    if(User.Identity?.IsAuthenticated==true) foreach(var screen in ScreenCatalog.All) access[screen.Key]=await Permissions.HasAsync(User,screen.Key);
    bool Can(string key)=>access.TryGetValue(key,out var allowed)&&allowed;
    var hasSettings=Can(ScreenCatalog.Suppliers)||Can(ScreenCatalog.Customers)||Can(ScreenCatalog.Materials)||Can(ScreenCatalog.Units)||Can(ScreenCatalog.PaymentMethods)||Can(ScreenCatalog.Users);
    var hasOperations=Can(ScreenCatalog.SupplierReceipts)||Can(ScreenCatalog.SupplierPayments)||Can(ScreenCatalog.CustomerDeliveries)||Can(ScreenCatalog.CustomerPayments);
    var hasReports=Can(ScreenCatalog.AuditTrail)||Can(ScreenCatalog.SupplierStatement)||Can(ScreenCatalog.CustomerStatement)||Can(ScreenCatalog.ProfitLoss);
    var currentUser=User.Identity?.IsAuthenticated==true?await UserManager.GetUserAsync(User):null;
    var currentTheme=currentUser?.Theme??"ocean";
    var returnUrl=Context.Request.PathBase+Context.Request.Path+Context.Request.QueryString;
}
<!DOCTYPE html><html lang="ar" dir="rtl" data-theme="@currentTheme"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><title>@ViewData["Title"] - نظام إدارة الأعمال</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body><header><nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm mb-4"><div class="container"><a class="navbar-brand fw-bold" asp-page="/Index">نظام إدارة الأعمال</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button><div id="mainNav" class="collapse navbar-collapse"><ul class="navbar-nav me-auto">
@if(hasSettings){<li class="nav-item dropdown"><a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">الإعدادات</a><ul class="dropdown-menu">@if(Can(ScreenCatalog.Suppliers)){<li><a class="dropdown-item" asp-page="/Settings/Suppliers/Index">إعداد الموردين</a></li>}@if(Can(ScreenCatalog.Customers)){<li><a class="dropdown-item" asp-page="/Settings/Customers/Index">إعداد العملاء</a></li>}@if(Can(ScreenCatalog.Units)){<li><a class="dropdown-item" asp-page="/Settings/Units/Index">إعداد وحدات القياس</a></li>}@if(Can(ScreenCatalog.Materials)){<li><a class="dropdown-item" asp-page="/Settings/Materials/Index">إعداد الخامات</a></li>}@if(Can(ScreenCatalog.PaymentMethods)){<li><a class="dropdown-item" asp-page="/Settings/PaymentMethods/Index">إعداد طرق الدفع</a></li>}@if(Can(ScreenCatalog.Users)){<li><a class="dropdown-item" asp-page="/Settings/Users/Index">المستخدمون والصلاحيات</a></li>}</ul></li>}
@if(hasOperations){<li class="nav-item dropdown"><a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">العمليات</a><ul class="dropdown-menu">@if(Can(ScreenCatalog.SupplierReceipts)){<li><a class="dropdown-item" asp-page="/Operations/SupplierReceipts/Index">إستلام بضاعة من مورد</a></li>}@if(Can(ScreenCatalog.SupplierPayments)){<li><a class="dropdown-item" asp-page="/Operations/SupplierPayments/Index">دفع إلى مورد</a></li>}@if(Can(ScreenCatalog.CustomerDeliveries)){<li><a class="dropdown-item" asp-page="/Operations/CustomerDeliveries/Index">توريد بضاعة لعميل</a></li>}@if(Can(ScreenCatalog.CustomerPayments)){<li><a class="dropdown-item" asp-page="/Operations/CustomerPayments/Index">قبض من عميل</a></li>}</ul></li>}
@if(hasReports){<li class="nav-item dropdown"><a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">التقارير</a><ul class="dropdown-menu">@if(Can(ScreenCatalog.SupplierStatement)){<li><a class="dropdown-item" asp-page="/Reports/SupplierStatement">كشف حساب مورد</a></li>}@if(Can(ScreenCatalog.CustomerStatement)){<li><a class="dropdown-item" asp-page="/Reports/CustomerStatement">كشف حساب عميل</a></li>}@if(Can(ScreenCatalog.ProfitLoss)){<li><a class="dropdown-item" asp-page="/Reports/ProfitLoss">الأرباح والخسائر</a></li>}@if(Can(ScreenCatalog.AuditTrail)){<li><a class="dropdown-item" asp-page="/Reports/AuditTrail">سجل المراجعة</a></li>}</ul></li>}
</ul>@if(currentUser is not null){<form method="post" asp-page="/Profile/Theme" asp-route-returnUrl="@returnUrl" class="theme-selector ms-2"><label for="themeSelect" class="visually-hidden">المظهر</label><select id="themeSelect" name="theme" class="form-select form-select-sm" onchange="this.form.submit()" title="اختر المظهر"><option value="ocean" selected="@(currentTheme=="ocean"?"selected":null)">الأزرق الحالي</option><option value="classic" selected="@(currentTheme=="classic"?"selected":null)">فاتح كلاسيكي</option><option value="emerald" selected="@(currentTheme=="emerald"?"selected":null)">زمردي</option><option value="burgundy" selected="@(currentTheme=="burgundy"?"selected":null)">عنابي</option><option value="dark" selected="@(currentTheme=="dark"?"selected":null)">داكن</option></select></form>}<partial name="_LoginPartial"/></div></div></nav></header><div class="container"><main role="main" class="pb-5">@RenderBody()</main></div><footer class="border-top text-muted py-3"><div class="container">نظام إدارة الأعمال © @DateTime.Now.Year</div></footer><script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
