@using Microsoft.AspNetCore.Identity
@using MYOB.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<ul class="navbar-nav">@if(SignInManager.IsSignedIn(User)){<li class="nav-item"><span class="nav-link text-white-50">@User.Identity?.Name</span></li><li class="nav-item"><form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index",new{area=""})"><button type="submit" class="nav-link btn btn-link text-white">تسجيل الخروج</button></form></li>}else{<li class="nav-item"><a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Login">تسجيل الدخول</a></li>}</ul>
