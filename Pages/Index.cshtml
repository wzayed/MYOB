@page
@model IndexModel
@{
    ViewData["Title"] = "الرئيسية";
}
<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />

@if (User.Identity?.IsAuthenticated != true)
{
    <section class="hero card border-0 shadow-sm">
        <div class="card-body p-5">
            <h1>إدارة أعمالك بوضوح وتحكّم</h1>
            <p class="text-muted">سجل الدخول لمتابعة الأرصدة والبضائع وحركات أعمالك.</p>
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary">تسجيل الدخول</a>
        </div>
    </section>
}
else
{
    <div class="dashboard">
        <header class="dash-heading">
            <div>
                <p class="text-muted mb-1">الرئيسية · حتى اليوم @Model.Today.ToString("yyyy/MM/dd")</p>
                <h1>نظرة عامة على أعمالك</h1>
                @if (!Model.Failed)
                {
                    <small class="text-muted">آخر تحديث: @Model.RefreshedAt.ToString("yyyy/MM/dd HH:mm") بتوقيت القاهرة</small>
                }
            </div>
            <a asp-page="/Index" asp-route-SupplierId="@Model.SupplierId" asp-route-Sort="@Model.Sort" asp-route-PageNumber="@Model.PageNumber" class="btn btn-outline-primary">تحديث البيانات</a>
        </header>
        @if (Model.Failed)
        {
            <div class="alert alert-danger" role="alert">تعذر تحميل بيانات لوحة الأعمال. يرجى إعادة المحاولة باستخدام تحديث البيانات.</div>
        }
        else
        {
            @if (!Model.SuppliersVisible && !Model.CustomersVisible && !Model.GoodsVisible)
            {
                <div class="card card-body">مرحباً بك. استخدم القائمة للوصول إلى الشاشات المتاحة لك. عرض ملخص الأعمال يتطلب صلاحيات التقارير أو استلام البضاعة.</div>
            }
            <section class="dash-metrics" aria-label="ملخص الأرصدة حتى اليوم">
                @if (Model.SuppliersVisible)
                {
                    <article class="dash-card">
                        <span class="dash-symbol" aria-hidden="true">↗</span>
                        <h2>المستحق للموردين</h2>
                        <strong class="dash-number">@Model.Suppliers.Sum(x => x.Amount).ToString("N2")</strong>
                        <p>@Model.Suppliers.Count مورد · بعد احتساب الأرصدة والمدفوعات</p>
                        <a href="#supplier-attention">عرض الموردين والأرصدة ←</a>
                    </article>
                }
                @if (Model.CustomersVisible)
                {
                    <article class="dash-card">
                        <span class="dash-symbol" aria-hidden="true">↙</span>
                        <h2>المستحق على العملاء</h2>
                        <strong class="dash-number">@Model.Customers.Sum(x => x.Amount).ToString("N2")</strong>
                        <p>@Model.Customers.Count عميل · المبالغ المتبقية للتحصيل</p>
                        <a href="#customer-attention">عرض العملاء والأرصدة ←</a>
                    </article>
                }
                @if (Model.GoodsVisible)
                {
                    <article class="dash-card">
                        <span class="dash-symbol" aria-hidden="true">▤</span>
                        <h2>بضاعة غير موردة للعملاء</h2>
                        <strong class="dash-number">@Model.GoodsValue.ToString("N2")</strong>
                        <p>@Model.GoodsCount بوليصة · تكلفة الشراء شاملة الضريبة</p>
                        <a href="#pending-goods">استعراض البضائع ←</a>
                    </article>
                }
                @if (Model.SuppliersVisible)
                {
                    <article class="dash-card">
                        <span class="dash-symbol" aria-hidden="true">＋</span>
                        <h2>أرصدة دائنة لدى الموردين</h2>
                        <strong class="dash-number">@Model.Credits.Sum(x => x.Amount).ToString("N2")</strong>
                        <p>@Model.Credits.Count مورد · رصيد مرحل متاح للاستخدام</p>
                        <a href="#credit-attention">عرض الأرصدة المتاحة ←</a>
                    </article>
                }
            </section>

            <h2 class="dash-section-title">يحتاج إلى اهتمام</h2>
            <p class="text-muted">أكبر الأرصدة وأقدم البضائع للمساعدة في ترتيب المتابعة.</p>
            <section class="dash-attention">
                @foreach (var category in new[] { "supplier", "customer", "credit" })
                {
                    var visible = category == "customer" ? Model.CustomersVisible : Model.SuppliersVisible;
                    if (!visible) { continue; }
                    var parties = category == "supplier" ? Model.Suppliers : category == "customer" ? Model.Customers : Model.Credits;
                    var title = category == "supplier" ? "مبالغ مستحقة للموردين" : category == "customer" ? "مبالغ مستحقة على العملاء" : "رصيد متاح لدى الموردين";
                    var reportPage = category == "customer" ? "/Reports/CustomerStatement" : "/Reports/SupplierStatement";
                    <article class="card card-body" id="@(category)-attention">
                        <h3>@title</h3>
                        @if (parties.Count == 0)
                        {
                            <p class="text-muted mb-0">لا توجد أرصدة حالياً.</p>
                        }
                        @foreach (var party in parties.Take(3))
                        {
                            <div class="dash-party">
                                <div><a asp-page="@reportPage" asp-route-Filter.PartyId="@party.Id">@party.Name</a><strong class="dash-number">@party.Amount.ToString("N2")</strong></div>
                                @if (category == "customer" && Model.CanCollect)
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-page="/Operations/CustomerPayments/Create" asp-route-customerId="@party.Id">تسجيل قبض</a>
                                }
                                @if (category != "customer" && Model.CanPay)
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-page="/Operations/SupplierPayments/Create" asp-route-supplierId="@party.Id">تسجيل دفع</a>
                                }
                            </div>
                        }
                        @if (parties.Count > 3)
                        {
                            <details class="mt-3">
                                <summary>عرض بقية الأرصدة (@(parties.Count - 3))</summary>
                                @foreach (var party in parties.Skip(3))
                                {
                                    <div class="dash-party"><a asp-page="@reportPage" asp-route-Filter.PartyId="@party.Id">@party.Name</a><strong class="dash-number">@party.Amount.ToString("N2")</strong></div>
                                }
                            </details>
                        }
                    </article>
                }
                @if (Model.GoodsVisible)
                {
                    <article class="card card-body">
                        <h3>الأقدم انتظاراً للتوريد</h3>
                        @if (Model.OldestGoods.Count == 0)
                        {
                            <p class="text-muted">لا توجد بضائع بانتظار التوريد.</p>
                        }
                        @foreach (var goods in Model.OldestGoods)
                        {
                            <div class="dash-party">
                                <div><strong>@goods.Policy · @goods.Supplier</strong><small>@goods.Material · @(Model.Today.DayNumber - goods.Date.DayNumber) يوم انتظار</small></div>
                                @if (Model.CanDeliver)
                                {
                                    <a asp-page="/Operations/CustomerDeliveries/Create" asp-route-policyId="@goods.Id" class="btn btn-sm btn-outline-primary">توريد لعميل</a>
                                }
                            </div>
                        }
                        <a asp-page="/Index" asp-route-Sort="oldest" asp-fragment="pending-goods">عرض حسب الأقدم ←</a>
                    </article>
                }
            </section>

            @if (Model.GoodsVisible)
            {
                <section id="pending-goods" class="card card-body mt-4">
                    <div class="dash-heading">
                        <div><h2>البضائع بانتظار توريدها للعملاء</h2><p class="text-muted mb-0">أحدث البوالص المستلمة وغير المخصصة · @Model.GoodsCount بوليصة إجمالاً</p></div>
                        <a asp-page="/Index" asp-fragment="pending-goods">عرض جميع البوالص</a>
                    </div>
                    <form method="get" asp-fragment="pending-goods" class="row g-3 mb-3">
                        <div class="col-md-7"><label asp-for="SupplierId" class="form-label">المورد</label><select asp-for="SupplierId" asp-items="Model.VendorOptions" class="form-select"><option value="">كل الموردين</option></select></div>
                        <div class="col-md-3"><label asp-for="Sort" class="form-label">ترتيب العرض</label><select asp-for="Sort" class="form-select"><option value="latest">الأحدث استلاماً</option><option value="oldest">الأطول انتظاراً</option><option value="cost">الأعلى تكلفة</option></select></div>
                        <div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">عرض النتائج</button></div>
                    </form>
                    <p class="text-muted" role="status">@Model.MatchingCount نتيجة · الصفحة @Model.PageNumber من @Model.TotalPages</p>
                    @if (Model.Goods.Count == 0)
                    {
                        <p class="dash-empty">@(Model.GoodsCount == 0 ? "لا توجد بضائع غير موردة للعملاء حالياً." : "لا توجد بوالص غير مخصصة للمورد المحدد. اختر مورداً آخر أو كل الموردين.")</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table dash-goods align-middle">
                                <caption class="visually-hidden">البوالص المستلمة من الموردين التي لم تُورّد للعملاء</caption>
                                <thead><tr><th>البوليصة / الاستلام</th><th>المورد / الخامة</th><th>الكمية والوحدة</th><th>السعر / الضريبة</th><th>تكلفة الشراء</th><th>الانتظار / التفاصيل</th><th>الإجراء</th></tr></thead>
                                <tbody>
                                    @foreach (var goods in Model.Goods)
                                    {
                                        <tr>
                                            <td data-label="البوليصة / الاستلام"><strong>@goods.Policy</strong><small class="dash-number">@goods.Date.ToString("yyyy/MM/dd")</small></td>
                                            <td data-label="المورد / الخامة"><strong>@goods.Supplier</strong><small>@goods.Material</small></td>
                                            <td data-label="الكمية والوحدة"><span class="dash-number">@goods.Quantity.ToString("N3")</span> @goods.Unit</td>
                                            <td data-label="السعر / الضريبة"><span class="dash-number">@goods.UnitPrice.ToString("N2")</span><small>ضريبة <bdi>@goods.Tax.ToString("0.##")%</bdi></small></td>
                                            <td data-label="تكلفة الشراء"><strong class="dash-number">@goods.Total.ToString("N2")</strong></td>
                                            <td data-label="الانتظار / التفاصيل">@(Model.Today.DayNumber - goods.Date.DayNumber) يوم
                                                @if (!string.IsNullOrWhiteSpace(goods.Notes))
                                                {
                                                    <details><summary>التفاصيل</summary><p class="dash-notes">@goods.Notes</p></details>
                                                }
                                            </td>
                                            <td data-label="الإجراء">
                                                @if (Model.CanDeliver)
                                                {
                                                    <a asp-page="/Operations/CustomerDeliveries/Create" asp-route-policyId="@goods.Id" class="btn btn-sm btn-outline-primary">توريد لعميل</a>
                                                }
                                                else { <span class="text-muted">عرض فقط</span> }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <nav class="d-flex gap-3 justify-content-center" aria-label="صفحات البوالص">
                            @if (Model.PageNumber > 1)
                            {
                                <a asp-route-SupplierId="@Model.SupplierId" asp-route-Sort="@Model.Sort" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-fragment="pending-goods" class="btn btn-outline-primary">السابق</a>
                            }
                            @if (Model.PageNumber < Model.TotalPages)
                            {
                                <a asp-route-SupplierId="@Model.SupplierId" asp-route-Sort="@Model.Sort" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-fragment="pending-goods" class="btn btn-outline-primary">التالي</a>
                            }
                        </nav>
                    }
                </section>
            }
            @if (Model.SuppliersVisible || Model.CustomersVisible)
            {
                <section class="card card-body mt-4">
                    <h2>حركة هذا الشهر</h2>
                    <p class="text-muted">من @Model.Today.ToString("yyyy/MM")/01 إلى @Model.Today.ToString("yyyy/MM/dd") · المقبوض والمدفوع يعبران عن النقد الفعلي</p>
                    <div class="dash-metrics dash-month">
                        @if (Model.SuppliersVisible)
                        {
                            <div><span>مدفوع للموردين</span><strong class="dash-number">@Model.MonthlyPaid.ToString("N2")</strong></div>
                            <div><span>قيمة المشتريات شاملة الضريبة</span><strong class="dash-number">@Model.MonthlyPurchases.ToString("N2")</strong></div>
                        }
                        @if (Model.CustomersVisible)
                        {
                            <div><span>مقبوض من العملاء</span><strong class="dash-number">@Model.MonthlyReceived.ToString("N2")</strong></div>
                            <div><span>قيمة التوريدات شاملة الضريبة</span><strong class="dash-number">@Model.MonthlySales.ToString("N2")</strong></div>
                        }
                    </div>
                </section>
            }
            <nav class="d-flex flex-wrap gap-2 mt-4" aria-label="عمليات سريعة">
                @if (Model.CanPay) { <a class="btn btn-primary" asp-page="/Operations/SupplierPayments/Create">تسجيل دفع إلى مورد</a> }
                @if (Model.CanCollect) { <a class="btn btn-primary" asp-page="/Operations/CustomerPayments/Create">تسجيل قبض من عميل</a> }
                @if (Model.CanDeliver) { <a class="btn btn-primary" asp-page="/Operations/CustomerDeliveries/Create">توريد بضاعة لعميل</a> }
            </nav>
        }
    </div>
}
