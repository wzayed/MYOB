@page
@model MYOB.Pages.Reports.SupplierStatementModel
@{ViewData["Title"]="كشف حساب مورد";}
<div class="d-flex justify-content-between align-items-center mb-3"><h1>كشف حساب مورد</h1>@if(Model.Report is not null){<a asp-page-handler="Pdf" asp-route-Filter.PartyId="@Model.Filter.PartyId" asp-route-Filter.FromDate="@Model.Filter.FromDate" asp-route-Filter.ToDate="@Model.Filter.ToDate" class="btn btn-danger">تصدير PDF</a>}</div>
<form method="get" class="card card-body mb-3"><div class="row g-3"><div class="col-md-4"><label class="form-label">المورد</label><select asp-for="Filter.PartyId" asp-items="Model.Suppliers" class="form-select"><option value="">اختر المورد</option></select><span asp-validation-for="Filter.PartyId" class="text-danger"></span></div><div class="col-md-3"><label class="form-label">من تاريخ</label><input asp-for="Filter.FromDate" type="date" class="form-control"/></div><div class="col-md-3"><label class="form-label">إلى تاريخ</label><input asp-for="Filter.ToDate" type="date" class="form-control"/></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">عرض</button></div></div></form>
@if(Model.Report is not null){<div class="report-header card card-body mb-3"><h5>@Model.Report.PartyName</h5><div>الفترة من @Model.Filter.FromDate?.ToString("yyyy/MM/dd") إلى @Model.Filter.ToDate?.ToString("yyyy/MM/dd")</div><div>الرصيد قبل الفترة: <strong>@Model.Report.OpeningBalance.ToString("N2")</strong></div></div><partial name="_AccountStatementTable" model="Model.Report"/>}
