@page
@model MYOB.Pages.Reports.SupplierStatementModel

@{
    ViewData["Title"] = "كشف حساب مورد";
    var fromDate = Model.Filter.FromDate?.ToString("yyyy/MM/dd");
    var toDate = Model.Filter.ToDate?.ToString("yyyy/MM/dd");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>كشف حساب مورد</h1>
    @if (Model.Report is not null)
    {
        <a asp-page-handler="Pdf"
           asp-route-Filter.ShowPrivateNotes="@Model.Filter.ShowPrivateNotes"
           asp-route-Filter.PartyId="@Model.Filter.PartyId"
           asp-route-Filter.RelatedPartyId="@Model.Filter.RelatedPartyId"
           asp-route-Filter.FromDate="@fromDate"
           asp-route-Filter.ToDate="@toDate"
           class="btn btn-danger">
            تصدير PDF
        </a>
    }
</div>

<form method="get" class="card card-body mb-3">
    <div class="row g-3">
        <div class="col-12">
            <label asp-for="Filter.ShowPrivateNotes" class="form-label">نوع الملاحظات</label>
            <select asp-for="Filter.ShowPrivateNotes" class="form-select">
                <option value="false">ملاحظات عامة</option>
                <option value="true">ملاحظات خاصة</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">المورد</label>
            <select asp-for="Filter.PartyId" asp-items="Model.Suppliers" class="form-select">
                <option value="">اختر المورد</option>
            </select>
            <span asp-validation-for="Filter.PartyId" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label class="form-label">العميل</label>
            <select asp-for="Filter.RelatedPartyId" asp-items="Model.Customers" class="form-select">
                <option value="">كل العملاء</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">من تاريخ</label>
            <input asp-for="Filter.FromDate" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control" />
            <span asp-validation-for="Filter.FromDate" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label class="form-label">إلى تاريخ</label>
            <input asp-for="Filter.ToDate" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control" />
            <span asp-validation-for="Filter.ToDate" class="text-danger"></span>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button class="btn btn-primary w-100">عرض</button>
        </div>
    </div>
</form>

@if (Model.Report is not null)
{
    <div class="report-header card card-body mb-3">
        <h5>@Model.Report.PartyName</h5>
        <div>نوع الملاحظات: @(Model.Filter.ShowPrivateNotes ? "ملاحظات خاصة" : "ملاحظات عامة")</div>
        <div>العميل: <strong>@(Model.Report.RelatedPartyName ?? "كل العملاء")</strong></div>
        <div>الفترة من @Model.Filter.FromDate?.ToString("yyyy/MM/dd") إلى @Model.Filter.ToDate?.ToString("yyyy/MM/dd")</div>
        <div>الرصيد قبل الفترة: <strong>@Model.Report.OpeningBalance.ToString("N2")</strong></div>
    </div>
    <partial name="_AccountStatementTable" model="Model.Report" />
}
