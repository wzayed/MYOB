@page
@model MYOB.Pages.Reports.ProfitLossModel

@{
    ViewData["Title"] = "الأرباح والخسائر";
    var realizedTotal = Model.Report.Realized.Sum(x => x.Value);
    var unrealizedTotal = Model.Report.Unrealized.Sum(x => x.Value);
    var totalProfit = realizedTotal + unrealizedTotal;
    var undeliveredCost = Model.Report.UndeliveredGoods.Sum(x => x.PurchaseCost);
    var fromDate = Model.Filter.FromDate?.ToString("yyyy/MM/dd");
    var toDate = Model.Filter.ToDate?.ToString("yyyy/MM/dd");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>الأرباح والخسائر المحققة وغير المحققة</h1>
    <a asp-page-handler="Pdf"
       asp-route-Filter.SupplierId="@Model.Filter.SupplierId"
       asp-route-Filter.CustomerId="@Model.Filter.CustomerId"
       asp-route-Filter.FromDate="@fromDate"
       asp-route-Filter.ToDate="@toDate"
       class="btn btn-danger">
        تصدير PDF
    </a>
</div>

<form method="get" class="card card-body mb-3">
    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label">من تاريخ</label>
            <input asp-for="Filter.FromDate" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control" />
            <span asp-validation-for="Filter.FromDate" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label class="form-label">إلى تاريخ</label>
            <input asp-for="Filter.ToDate" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control" />
            <span asp-validation-for="Filter.ToDate" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label class="form-label">المورد</label>
            <select asp-for="Filter.SupplierId" asp-items="Model.Suppliers" class="form-select">
                <option value="">كل الموردين</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">العميل</label>
            <select asp-for="Filter.CustomerId" asp-items="Model.Customers" class="form-select">
                <option value="">كل العملاء</option>
            </select>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button class="btn btn-primary w-100">عرض</button>
        </div>
    </div>
</form>

<div class="report-header card card-body mb-3">
    <div>
        الفترة من @Model.Filter.FromDate?.ToString("yyyy/MM/dd")
        إلى @Model.Filter.ToDate?.ToString("yyyy/MM/dd")
    </div>
    <div>
        المورد: <strong>@Model.SupplierName</strong> |
        العميل: <strong>@Model.CustomerName</strong>
    </div>
    <small class="text-muted">
        هامش الربح = الكمية × (سعر البيع − سعر الشراء). المحقق يُحسب بنسبة المبالغ
        المحصلة فعلياً خلال الفترة، وغير المحقق هو نسبة الرصيد الذي لم يُحصّل حتى
        تاريخ نهاية التقرير.
    </small>
</div>

<h4 class="text-success">المحقق</h4>
<partial name="_ProfitLossTable" model="Model.Report.Realized" />
<div class="text-end fw-bold mb-4">صافي الربح/الخسارة: @realizedTotal.ToString("N2")</div>

<h4 class="text-warning">غير المحقق - مبالغ لم تُحصّل</h4>
<partial name="_ProfitLossTable" model="Model.Report.Unrealized" />
<div class="text-end fw-bold">صافي الربح/الخسارة غير المحقق: @unrealizedTotal.ToString("N2")</div>

<div class="alert alert-primary text-end fw-bold fs-5 mt-3">
    إجمالي الربح/الخسارة: @totalProfit.ToString("N2")
</div>

<h4 class="text-primary mt-4">بضاعة غير موردة للعملاء</h4>
<div class="table-responsive">
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>المورد</th>
                <th>رقم البوليصة</th>
                <th>الخامة</th>
                <th>الكمية</th>
                <th>تكلفة الشراء</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Report.UndeliveredGoods.Count == 0)
            {
                <tr><td colspan="5" class="text-center py-4">لا توجد بضاعة غير موردة مطابقة</td></tr>
            }
            @foreach (var row in Model.Report.UndeliveredGoods)
            {
                <tr>
                    <td>@row.SupplierName</td>
                    <td>@row.PolicyNumber</td>
                    <td>@row.MaterialName</td>
                    <td>@row.Quantity.ToString("N2")</td>
                    <td>@row.PurchaseCost.ToString("N2")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="fw-bold">
                <td colspan="4">إجمالي تكلفة البضاعة غير الموردة</td>
                <td>@undeliveredCost.ToString("N2")</td>
            </tr>
        </tfoot>
    </table>
</div>
