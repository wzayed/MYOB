@page
@model MYOB.Pages.Reports.ProfitLossModel
@{ViewData["Title"]="الأرباح والخسائر";}
<div class="d-flex justify-content-between align-items-center mb-3"><h1>الأرباح والخسائر المحققة وغير المحققة</h1><a asp-page-handler="Pdf" asp-route-Filter.SupplierId="@Model.Filter.SupplierId" asp-route-Filter.CustomerId="@Model.Filter.CustomerId" asp-route-Filter.FromDate="@Model.Filter.FromDate" asp-route-Filter.ToDate="@Model.Filter.ToDate" class="btn btn-danger">تصدير PDF</a></div>
<form method="get" class="card card-body mb-3"><div class="row g-3"><div class="col-md-3"><label class="form-label">من تاريخ</label><input asp-for="Filter.FromDate" type="date" class="form-control"/></div><div class="col-md-3"><label class="form-label">إلى تاريخ</label><input asp-for="Filter.ToDate" type="date" class="form-control"/></div><div class="col-md-2"><label class="form-label">المورد</label><select asp-for="Filter.SupplierId" asp-items="Model.Suppliers" class="form-select"><option value="">كل الموردين</option></select></div><div class="col-md-2"><label class="form-label">العميل</label><select asp-for="Filter.CustomerId" asp-items="Model.Customers" class="form-select"><option value="">كل العملاء</option></select></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">عرض</button></div></div></form>
<div class="report-header card card-body mb-3"><div>الفترة من @Model.Filter.FromDate?.ToString("yyyy/MM/dd") إلى @Model.Filter.ToDate?.ToString("yyyy/MM/dd")</div><div>المورد: <strong>@Model.SupplierName</strong> | العميل: <strong>@Model.CustomerName</strong></div><small class="text-muted">المحقق = الكمية × (سعر البيع − سعر الشراء). غير المحقق يعرض تكلفة البضاعة التي لم تُورّد لعميل كقيمة سالبة.</small></div>
<h4 class="text-success">المحقق</h4><partial name="_ProfitLossTable" model="Model.Report.Realized"/><div class="text-end fw-bold mb-4">صافي الربح/الخسارة: @Model.Report.Realized.Sum(x=>x.Value).ToString("N2")</div>
<h4 class="text-warning">غير المحقق - بضاعة غير موردة</h4><partial name="_ProfitLossTable" model="Model.Report.Unrealized"/><div class="text-end fw-bold">إجمالي التكلفة غير المحققة: @Model.Report.Unrealized.Sum(x=>x.Value).ToString("N2")</div>
