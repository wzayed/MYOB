@page
@model MYOB.Pages.Reports.AuditTrailModel
@{
    ViewData["Title"] = "سجل المراجعة";
    var fromDate = Model.Filter.FromDate?.ToString("yyyy/MM/dd");
    var toDate = Model.Filter.ToDate?.ToString("yyyy/MM/dd");
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>سجل المراجعة</h1>
    <a asp-page-handler="Pdf" asp-route-Filter.UserName="@Model.Filter.UserName" asp-route-Filter.Screen="@Model.Filter.Screen" asp-route-Filter.Action="@Model.Filter.Action" asp-route-Filter.FromDate="@fromDate" asp-route-Filter.ToDate="@toDate" class="btn btn-danger">تصدير PDF</a>
</div>
<form method="get" class="card card-body mb-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-3"><label class="form-label">المستخدم</label><input asp-for="Filter.UserName" class="form-control" list="users-list" /><datalist id="users-list">@foreach (var u in Model.Users) { <option value="@u"></option> }</datalist></div>
        <div class="col-md-3"><label class="form-label">الشاشة</label><input asp-for="Filter.Screen" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">نوع الإجراء</label><select asp-for="Filter.Action" class="form-select"><option value="">الكل</option><option>تسجيل دخول</option><option>تسجيل خروج</option><option>إنشاء</option><option>تعديل</option><option>حذف</option></select></div>
        <div class="col-md-2"><label class="form-label">من تاريخ</label><input asp-for="Filter.FromDate" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control" /><span asp-validation-for="Filter.FromDate" class="text-danger"></span></div>
        <div class="col-md-2"><label class="form-label">إلى تاريخ</label><input asp-for="Filter.ToDate" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control" /><span asp-validation-for="Filter.ToDate" class="text-danger"></span></div>
    </div>
    <div class="mt-3"><button class="btn btn-primary">عرض</button> <a asp-page="AuditTrail" class="btn btn-secondary">مسح المرشحات</a></div>
</form>
<div class="table-responsive"><table class="table table-striped table-sm"><thead><tr><th>التاريخ</th><th>المستخدم</th><th>الشاشة</th><th>الإجراء</th><th>الكيان</th><th>رقم السجل</th><th>IP</th></tr></thead><tbody>
@if (Model.Rows.Count == 0) { <tr><td colspan="7" class="text-center py-4">لا توجد بيانات مطابقة</td></tr> }
@foreach (var r in Model.Rows) { <tr><td>@r.OccurredAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td><td>@r.UserName</td><td>@r.Screen</td><td>@r.Action</td><td>@r.EntityName</td><td>@r.RecordId</td><td>@r.IpAddress</td></tr> }
</tbody></table></div>
<nav><ul class="pagination">@for (var p = 1; p <= Model.TotalPages; p++) { <li class="page-item @(p == Model.PageNumber ? "active" : "")"><a class="page-link" asp-route-PageNumber="@p" asp-route-Filter.UserName="@Model.Filter.UserName" asp-route-Filter.Screen="@Model.Filter.Screen" asp-route-Filter.Action="@Model.Filter.Action" asp-route-Filter.FromDate="@fromDate" asp-route-Filter.ToDate="@toDate">@p</a></li> }</ul></nav>
